# ============================================================
# Nexora Business Suite — Environment (NEVER commit real secrets)
# ============================================================

# Railway PostgreSQL (use PUBLIC TCP proxy URL for Vercel / local)
# Internal URL only works between Railway services:
#   postgresql://postgres:***@postgres.railway.internal:5432/railway
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nexora Business Suite"
APP_LOCALE="pt-AO"
APP_CURRENCY="AOA"
APP_TIMEZONE="Africa/Luanda"

# Global admin bootstrap (auto-promoted on register/login)
GLOBAL_ADMIN_EMAIL="phedilsondream@gmail.com"

# Trial defaults (overridable in platform_settings table)
DEFAULT_TRIAL_DAYS="30"
TRIAL_ENABLED="true"

# Payments adapter (NOT_CONFIGURED | SANDBOX | LIVE)
PAYMENT_GATEWAY_STATUS="NOT_CONFIGURED"
