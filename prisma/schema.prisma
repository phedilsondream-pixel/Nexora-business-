// Nexora Business Suite — Prisma schema (Railway PostgreSQL)
// Multi-tenant: every business table has organizationId where applicable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== AUTH & TENANCY ==========

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String?
  phone          String?
  isGlobalAdmin  Boolean   @default(false)
  locale         String    @default("pt-AO")
  timezone       String    @default("Africa/Luanda")
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  memberships    OrganizationMember[]
  sessions       Session[]
  auditLogs      AuditLog[] @relation("ActorLogs")

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Plan {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  priceMonthly  Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly   Decimal  @default(0) @db.Decimal(12, 2)
  currency      String   @default("AOA")
  maxUsers      Int?
  maxBranches   Int?
  maxStorageMb  Int?
  features      Json     @default("{}")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizations Organization[]
  subscriptions Subscription[]

  @@map("plans")
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  legalName          String?
  taxId              String?
  email              String?
  phone              String?
  address            Json?
  logoUrl            String?
  planId             String?
  status             String    @default("trial")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  settings           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  plan               Plan?     @relation(fields: [planId], references: [id])
  members            OrganizationMember[]
  subscriptions      Subscription[]
  roles              Role[]
  auditLogs          AuditLog[]
  financeAccounts    FinanceAccount[]
  financeCategories  FinanceCategory[]
  financeTransactions FinanceTransaction[]
  customers          Customer[]
  documentSeries     DocumentSeries[]
  commercialDocuments CommercialDocument[]
  products           Product[]
  warehouses         Warehouse[]
  leads              Lead[]
  employees          Employee[]
  projects           Project[]
  supportTickets     SupportTicket[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  roleId         String?
  status         String    @default("active")
  isOwner        Boolean   @default(false)
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role?        @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  permissions    Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Subscription {
  id                 String    @id @default(uuid())
  organizationId     String
  planId             String
  status             String    @default("trial")
  billingCycle       String    @default("monthly")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?
  trialEndsAt        DateTime?
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@map("subscriptions")
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ========== FINANCE ==========

model FinanceAccount {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  type           String
  currency       String    @default("AOA")
  initialBalance Decimal   @default(0) @db.Decimal(15, 2)
  currentBalance Decimal   @default(0) @db.Decimal(15, 2)
  bankName       String?
  accountNumber  String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   FinanceTransaction[]

  @@index([organizationId])
  @@map("finance_accounts")
}

model FinanceCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  type           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("finance_categories")
}

model FinanceTransaction {
  id             String    @id @default(uuid())
  organizationId String
  accountId      String
  type           String
  amount         Decimal   @db.Decimal(15, 2)
  currency       String    @default("AOA")
  description    String?
  reference      String?
  transactionDate DateTime @db.Date
  status         String    @default("confirmed")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        FinanceAccount @relation(fields: [accountId], references: [id])

  @@index([organizationId])
  @@index([transactionDate])
  @@map("finance_transactions")
}

// ========== INVOICING ==========

model Customer {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  taxId          String?
  email          String?
  phone          String?
  customerType   String    @default("company")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      CommercialDocument[]

  @@index([organizationId])
  @@map("customers")
}

model DocumentSeries {
  id             String   @id @default(uuid())
  organizationId String
  documentType   String
  seriesCode     String
  prefix         String
  nextNumber     Int      @default(1)
  year           Int
  isActive       Boolean  @default(true)
  agtRegistered  Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, seriesCode])
  @@map("document_series")
}

model CommercialDocument {
  id             String    @id @default(uuid())
  organizationId String
  seriesId       String?
  documentType   String
  documentNumber String
  status         String    @default("draft")
  customerId     String?
  customerName   String?
  customerTaxId  String?
  issueDate      DateTime  @db.Date
  dueDate        DateTime? @db.Date
  currency       String    @default("AOA")
  subtotal       Decimal   @default(0) @db.Decimal(15, 2)
  taxTotal       Decimal   @default(0) @db.Decimal(15, 2)
  total          Decimal   @default(0) @db.Decimal(15, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(15, 2)
  amountDue      Decimal   @default(0) @db.Decimal(15, 2)
  notes          String?
  agtStatus      String    @default("not_applicable")
  agtHash        String?
  agtAtcud       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  lines          DocumentLine[]

  @@index([organizationId])
  @@index([documentNumber])
  @@map("commercial_documents")
}

model DocumentLine {
  id          String  @id @default(uuid())
  documentId  String
  lineNumber  Int
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @default(0) @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(15, 2)
  lineTotal   Decimal @default(0) @db.Decimal(15, 2)

  document    CommercialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_lines")
}

// ========== STOCK ==========

model Product {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  sku            String?
  unit           String    @default("un")
  costPrice      Decimal   @default(0) @db.Decimal(15, 2)
  salePrice      Decimal   @default(0) @db.Decimal(15, 2)
  taxRate        Decimal   @default(14) @db.Decimal(5, 2)
  minStock       Decimal   @default(0) @db.Decimal(12, 3)
  trackStock     Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels    StockLevel[]

  @@index([organizationId])
  @@map("products")
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels    StockLevel[]

  @@index([organizationId])
  @@map("warehouses")
}

model StockLevel {
  id             String  @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  quantity       Decimal @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime @updatedAt

  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

// ========== CRM ==========

model Lead {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  email           String?
  phone           String?
  companyName     String?
  source          String?
  status          String    @default("new")
  estimatedValue  Decimal?  @db.Decimal(15, 2)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("leads")
}

// ========== HR ==========

model Employee {
  id             String    @id @default(uuid())
  organizationId String
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  department     String?
  contractType   String?
  hireDate       DateTime? @db.Date
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests  LeaveRequest[]

  @@index([organizationId])
  @@map("employees")
}

model LeaveRequest {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  leaveType      String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  daysCount      Decimal  @db.Decimal(5, 1)
  reason         String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("leave_requests")
}

// ========== PROJECTS ==========

model Project {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         String    @default("active")
  priority       String    @default("medium")
  dueDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([organizationId])
  @@map("projects")
}

model Task {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String?
  title          String
  description    String?
  status         String    @default("todo")
  priority       String    @default("medium")
  dueDate        DateTime? @db.Date
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tasks")
}

// ========== SUPPORT ==========

model SupportTicket {
  id             String    @id @default(uuid())
  organizationId String
  ticketNumber   String
  subject        String
  description    String?
  category       String    @default("general")
  priority       String    @default("medium")
  status         String    @default("open")
  requesterName  String?
  requesterEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       TicketMessage[]

  @@index([organizationId])
  @@map("support_tickets")
}

model TicketMessage {
  id             String   @id @default(uuid())
  organizationId String
  ticketId       String
  content        String
  isInternal     Boolean  @default(false)
  authorName     String?
  createdAt      DateTime @default(now())

  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}
