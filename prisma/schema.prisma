// Nexora Business Suite — Prisma schema mapped to Supabase (snake_case)
// Project: jlhfltgghdmvnthusfhl | Region: eu-west-1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String?   @map("full_name")
  phone         String?
  isGlobalAdmin Boolean   @default(false) @map("is_global_admin")
  locale        String    @default("pt-AO")
  timezone      String    @default("Africa/Luanda")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  memberships OrganizationMember[]
  sessions    Session[]
  auditLogs   AuditLog[] @relation("ActorLogs")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceYearly  Decimal  @default(0) @map("price_yearly") @db.Decimal(12, 2)
  currency     String   @default("AOA")
  maxUsers     Int?     @map("max_users")
  maxBranches  Int?     @map("max_branches")
  maxStorageMb Int?     @map("max_storage_mb")
  features     Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organizations Organization[]
  subscriptions Subscription[]

  @@map("plans")
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  legalName          String?   @map("legal_name")
  taxId              String?   @map("tax_id")
  email              String?
  phone              String?
  address            Json?
  logoUrl            String?   @map("logo_url")
  planId             String?   @map("plan_id")
  status             String    @default("trial")
  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  settings           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  plan                Plan?                 @relation(fields: [planId], references: [id])
  members             OrganizationMember[]
  subscriptions       Subscription[]
  roles               Role[]
  auditLogs           AuditLog[]
  financeAccounts     FinanceAccount[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]
  customers           Customer[]
  documentSeries      DocumentSeries[]
  commercialDocuments CommercialDocument[]
  products            Product[]
  warehouses          Warehouse[]
  leads               Lead[]
  employees           Employee[]
  projects            Project[]
  supportTickets      SupportTicket[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  roleId         String?   @map("role_id")
  status         String    @default("active")
  isOwner        Boolean   @default(false) @map("is_owner")
  joinedAt       DateTime? @map("joined_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  permissions    Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Subscription {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  planId             String    @map("plan_id")
  status             String    @default("trial")
  billingCycle       String    @default("monthly") @map("billing_cycle")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime? @map("cancelled_at")
  trialEndsAt        DateTime? @map("trial_ends_at")
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@map("subscriptions")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("ActorLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FinanceAccount {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  type           String   @default("cash")
  currency       String   @default("AOA")
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@index([organizationId])
  @@map("finance_accounts")
}

model FinanceCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  type           String   @default("expense")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@index([organizationId])
  @@map("finance_categories")
}

model FinanceTransaction {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  accountId      String   @map("account_id")
  categoryId     String?  @map("category_id")
  type           String
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("AOA")
  description    String?
  reference      String?
  occurredAt     DateTime @default(now()) @map("occurred_at")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     FinanceCategory? @relation(fields: [categoryId], references: [id])

  @@index([organizationId])
  @@map("finance_transactions")
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  taxId          String?  @map("tax_id")
  email          String?
  phone          String?
  address        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    CommercialDocument[]

  @@index([organizationId])
  @@map("customers")
}

model DocumentSeries {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  documentType   String @map("document_type")
  prefix         String
  nextNumber     Int    @default(1) @map("next_number")
  year           Int?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    CommercialDocument[]

  @@unique([organizationId, documentType, year])
  @@map("document_series")
}

model CommercialDocument {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  customerId     String?   @map("customer_id")
  seriesId       String?   @map("series_id")
  documentType   String    @map("document_type")
  number         String
  status         String    @default("draft")
  issueDate      DateTime? @map("issue_date") @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  currency       String    @default("AOA")
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal   @default(0) @map("tax_total") @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  lines          Json      @default("[]")
  agtHash        String?   @map("agt_hash")
  agtSignature   String?   @map("agt_signature")
  agtAtcud       String?   @map("agt_atcud")
  agtQrCode      String?   @map("agt_qr_code")
  notes          String?
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?      @relation(fields: [customerId], references: [id])
  series       DocumentSeries? @relation(fields: [seriesId], references: [id])

  @@unique([organizationId, documentType, number])
  @@index([organizationId])
  @@map("commercial_documents")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  sku            String?
  name           String
  description    String?
  unit           String   @default("un")
  price          Decimal  @default(0) @db.Decimal(14, 2)
  cost           Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @default("AOA")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("products")
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  location       String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("warehouses")
}

model StockLevel {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  productId      String  @map("product_id")
  warehouseId    String  @map("warehouse_id")
  quantity       Decimal @default(0) @db.Decimal(14, 3)
  minQuantity    Decimal @default(0) @map("min_quantity") @db.Decimal(14, 3)

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  warehouseId    String   @map("warehouse_id")
  type           String
  quantity       Decimal  @db.Decimal(14, 3)
  note           String?
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("stock_movements")
}

model Lead {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  email          String?
  phone          String?
  stage          String   @default("new")
  value          Decimal? @default(0) @db.Decimal(14, 2)
  currency       String   @default("AOA")
  source         String?
  ownerUserId    String?  @map("owner_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model Employee {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  fullName       String    @map("full_name")
  email          String?
  phone          String?
  position       String?
  department     String?
  hireDate       DateTime? @map("hire_date") @db.Date
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("employees")
}

model Project {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  status         String    @default("active")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@map("projects")
}

model Task {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  projectId      String?   @map("project_id")
  title          String
  status         String    @default("todo")
  assigneeId     String?   @map("assignee_id")
  dueDate        DateTime? @map("due_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model SupportTicket {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  number         String
  subject        String
  status         String   @default("open")
  priority       String   @default("medium")
  requesterId    String?  @map("requester_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@map("support_tickets")
}
